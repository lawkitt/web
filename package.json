{
  "name": "lawkitt-marketing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/tasks.mjs build",
    "preview": "astro preview --host 127.0.0.1",
    "typecheck": "astro check",
    "workers:preview": "node scripts/tasks.mjs workers-preview",
    "deploy": "node scripts/tasks.mjs deploy",
    "assets:brand": "node scripts/generate-brand-assets.mjs",
    "verify": "node scripts/verify-build.mjs",
    "build:preview": "node scripts/tasks.mjs build-preview",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write src scripts tests astro.config.mjs package.json tsconfig.json .github .prettierrc.json",
    "format:check": "prettier --check src scripts tests astro.config.mjs package.json tsconfig.json .github .prettierrc.json",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build && npm run verify"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "astro": "7.3.5",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "6.0.3",
    "wrangler": "4.149.0"
  }
}
