# Where things are in the mdoc window, in window points (x y from the window's
# top-left corner, traffic lights included), for a 1440 × 900 window.
# Sourced by capture/session.sh and capture/take.sh.
#
# Re-measure after a UI change: run `capture/take.sh <profile> Dark start detect`,
# open stills/review-dark.png (2880 × 1800, Retina) and halve the pixel position of
# the control you need. `node capture/measure.mjs <still>` draws a labelled grid over
# the still (out/measure.png) to make that quick. Only moved controls need updating.

# Window placement on the main display (points).
WIN_X=120
WIN_Y=60
WIN_W=1440
WIN_H=900

# Sidebar tabs (session order: letter, then scan; Restored is inserted second).
TAB_LETTER="100 176"
TAB_SCAN="100 244"

# Header.
PSEUDONYMIZE="1366 31" # primary action before a scan; becomes "Apply N" at the same place
APPLY="1364 31"
PANEL_TOGGLE="1308 30" # in Side by side, hides the inspector

# Text (letter-plain tab, inspector open, after Pseudonymize).
MENTION_PRIYA="818 476"   # "Priya Raman" in the second paragraph: tooltip, then click
MISSED_FROM="667 246"     # "Unit 9, …" (start of the missed address)
MISSED_TO="351 270"       # "… SO14 3TL" (end, before the full stop)
REPLACE_CHIP="313 242"    # floating "Replace ⌘⌥P" chip above that selection

# Mention bar (opened on Priya Raman, then on the added address).
ALIAS_FIELD="577 511"     # PERSON_2 field: opens "Same as…"
CATEGORY="718 284"        # "Other ▾" on the added address
CATEGORY_ADDRESS="741 437" # "Address" in that dropdown
BAR_CLOSE="1024 284"      # × of the mention bar on the address

# Inspector.
KEEP_COURTS="1079 513"    # checkbox of "Business and Property Courts" (Priya's row expanded)
COPY_FOR_AI="1240 206"    # Share tab
PASTE_REPLY="1240 420"    # Share tab

# Floating view pill (appears on hover near the bottom of the editor).
PILL_HOVER="780 540"
SIDE_BY_SIDE="708 855"

# Pointer rests inside the window, away from controls and mentions.
REST_INSPECTOR="1180 560"
REST_EDITOR="880 590"
DESELECT="780 580"        # empty editor area right of the table: clears a selection
