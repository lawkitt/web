{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lawkitt-web",
  "compatibility_date": "2026-10-09",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "lawkitt.com", "custom_domain": true }]
}
