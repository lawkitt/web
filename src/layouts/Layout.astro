---
import wordmark from "../assets/lawkitt-wordmark.svg?url";
import dmSansLatinUrl from "../assets/fonts/dm-sans-latin.woff2?url";
import "../styles/fonts.css";
import "../styles/global.css";
import { SITE } from "../lib/site";
import Arrow from "../components/Arrow.astro";
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  socialImage?: string;
}
const {
  title = "Lawkitt — Free, open-source tools for legal work",
  description = SITE.description,
  noindex = false,
  socialImage = "/social/lawkitt.png",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.origin);
const preview =
  import.meta.env.DEV || import.meta.env.PUBLIC_PREVIEW === "true";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#09090b" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex || preview ? "noindex, nofollow" : "index, follow"}
    />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      href={dmSansLatinUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Lawkitt" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(socialImage, SITE.origin)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={
        socialImage.includes("mdoc")
          ? "mdoc by Lawkitt. Legal documents, prepared for your next step."
          : "Lawkitt. Practical tools for everyday legal work."
      }
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(socialImage, SITE.origin)} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="nav">
      <div class="container nav-inner">
        <a class="brand" href="/" aria-label="Lawkitt home">
          <img src={wordmark} alt="Lawkitt" width="119" height="32" />
        </a>
        <nav class="nav-links" aria-label="Main navigation">
          <a
            href="/tools/mdoc/"
            aria-current={
              Astro.url.pathname === "/tools/mdoc/" ? "page" : undefined
            }
          >
            mdoc
          </a>
          <a
            href="/tools/mdoc/download/"
            aria-current={
              Astro.url.pathname === "/tools/mdoc/download/"
                ? "page"
                : undefined
            }
          >
            Download
          </a>
          <a class="nav-github" href={SITE.github}>
            GitHub <Arrow diagonal />
          </a>
          <a class="btn btn-primary nav-cta" href="/tools/mdoc/download/">
            Get mdoc
          </a>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="footer">
      <div class="container footer-inner">
        <div>
          <a class="brand footer-brand" href="/" aria-label="Lawkitt home">
            <img
              src={wordmark}
              alt="Lawkitt"
              width="100"
              height="27"
              loading="lazy"
            />
          </a>
          <p>Small tools. Useful work.</p>
          <p class="footer-legal">
            ChatGPT and Claude are trademarks of their respective owners.
            Lawkitt is not affiliated with OpenAI or Anthropic.
          </p>
        </div>
        <nav aria-label="Footer navigation">
          <a href="/tools/mdoc/">mdoc</a>
          <a href="/tools/mdoc/download/">Download</a>
          <a href={SITE.github}>GitHub</a>
          <a href="https://github.com/lawkitt/mdoc/issues">
            Support & contributions
          </a>
        </nav>
        <p class="footer-note">
          Free & open source.
          <br />
          Built by Lawkitt.
        </p>
      </div>
    </footer>
  </body>
</html>
