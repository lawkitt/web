---
import Layout from "../../../layouts/Layout.astro";
import Arrow from "../../../components/Arrow.astro";
import ProductScreenshot from "../../../components/ProductScreenshot.astro";
import Pillars from "../../../components/Pillars.astro";
import Workflow from "../../../components/Workflow.astro";
import { Image } from "astro:assets";
import { mdoc } from "../../../lib/catalog";
import { latestMdocRelease, mdocAvailability } from "../../../lib/releases";
import { Content } from "../../../content/tools/mdoc.md";
---

<Layout
  title="mdoc — Prepare legal documents for AI, privately | Lawkitt"
  description="Open PDFs, scans and Word files, pseudonymize client names and other sensitive details, and copy clean text into ChatGPT, Claude or any AI tool. Free and local on Mac and Windows."
  socialImage="/social/mdoc.png"
>
  <section class="hero product-hero">
    <div class="container">
      <div class="product-heading" data-rise>
        <Image src={mdoc.icon} alt="" width={48} height={48} format="webp" />
        <span>mdoc</span>
        <span class="tag">Free · Open source</span>
      </div>
      <h1 data-rise style="--d:.07s">
        {mdoc.headline}
      </h1>
      <p class="product-intro" data-rise style="--d:.14s">
        {mdoc.pitch}
      </p>
      <div class="actions" data-rise style="--d:.21s">
        <a class="btn btn-primary" href="/tools/mdoc/download/">
          Get mdoc <Arrow />
        </a>
        <a class="btn btn-ghost" href="#how-it-works">
          See how it works <span aria-hidden="true">↓</span>
        </a>
      </div>
      <p class="availability-note">
        {mdocAvailability} <span aria-hidden="true">·</span> macOS (Apple
        Silicon) and Windows
      </p>
      <div class="hero-shot">
        <ProductScreenshot />
      </div>
    </div>
  </section>
  <nav class="product-nav container" aria-label="On this page">
    <a href="#why">Why mdoc</a>
    <a href="#how-it-works">How it works</a>
    <a href="#privacy">Privacy</a>
    <a href="#questions-lawyers-ask">Questions</a>
  </nav>
  <section class="section" id="why" aria-labelledby="why-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">01 / Why mdoc</p>
          <h2 id="why-title">Everything AI needs. Nothing it shouldn’t see.</h2>
        </div>
        <p>
          The documents lawyers handle, ready for an AI assistant in minutes,
          with confidential details under your control.
        </p>
      </div>
      <Pillars />
    </div>
  </section>
  <section class="section" id="how-it-works" aria-labelledby="workflow-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">02 / How it works</p>
          <h2 id="workflow-title">Open. Pseudonymize. Copy.</h2>
        </div>
        <p>Three steps. Your judgment stays in charge of each one.</p>
      </div>
      <Workflow />
    </div>
  </section>
  <section class="section privacy" id="privacy" aria-labelledby="privacy-title">
    <div class="container privacy-grid">
      <div>
        <p class="eyebrow">03 / Privacy</p>
        <h2 id="privacy-title">
          Nothing leaves your computer until you copy it.
        </h2>
      </div>
      <ul class="privacy-list">
        <li>
          <strong>No uploads.</strong> mdoc opens, reads and recognizes your
          documents on your own Mac or PC.
        </li>
        <li>
          <strong>No account, no tracking.</strong> There is nothing to sign up
          for, and mdoc does not report on what you do.
        </li>
        <li>
          <strong>You choose what is shared.</strong> Text reaches an AI tool
          only when you copy it and paste it there yourself.
        </li>
        <li>
          <strong>Originals stay untouched.</strong> mdoc never changes the file
          you opened.
        </li>
      </ul>
    </div>
  </section>
  <section class="section product-content">
    <div class="container prose-grid">
      <aside>
        <p class="eyebrow">04 / Questions</p>
        <p class="aside-copy">
          Straight answers,
          <br />
          including the limits.
        </p>
      </aside>
      <div class="prose">
        <Content />
      </div>
    </div>
  </section>
  <section class="product-cta">
    <div class="container">
      <div class="cta-panel">
        <div>
          <p class="eyebrow">05 / Get mdoc</p>
          <h2>
            Ready for your
            <br />
            next document.
          </h2>
          <p>
            {latestMdocRelease
              ? "Free for Apple Silicon Macs and Windows PCs. No account needed."
              : "The first public release is on its way. Watch the repository on GitHub to hear when it lands."}
          </p>
        </div>
        <div class="actions">
          <a class="btn btn-primary" href="/tools/mdoc/download/">
            Get mdoc <Arrow />
          </a>
          <a class="btn btn-ghost" href={mdoc.source}>
            View source <Arrow diagonal />
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
<style>
  .product-hero {
    padding: 40px 0 0;
  }
  .privacy-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
  }
  .privacy-grid h2 {
    margin-top: 18px;
  }
  .privacy-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .privacy-list li {
    padding: 20px 0;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 15px;
    line-height: 1.7;
  }
  .privacy-list li:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .privacy-list strong {
    display: block;
    color: var(--fg);
    font-weight: 600;
    margin-bottom: 4px;
  }
  .product-heading {
    display: flex;
    gap: 14px;
    align-items: center;
    margin: 32px 0 28px;
  }
  .product-heading img {
    border-radius: 10px;
  }
  .product-heading > span:not(.tag) {
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .product-heading .tag {
    margin-left: 8px;
  }
  .product-intro {
    max-width: 720px;
    line-height: 1.6;
  }
  .product-hero h1 {
    max-width: 1000px;
    font-size: clamp(44px, 5.4vw, 72px);
  }
  .product-intro {
    color: var(--muted);
    font-size: 18px;
    margin-top: 28px;
  }
  .product-hero .actions {
    margin-top: 28px;
  }
  .availability-note {
    color: var(--dim);
    font-size: 11px;
    margin-top: 16px;
  }
  .availability-note span {
    margin: 0 6px;
  }
  .hero-shot {
    margin-top: 60px;
  }
  .product-nav {
    display: flex;
    gap: 30px;
    font-size: 12px;
    color: var(--muted);
    padding-top: 28px;
    padding-bottom: 28px;
    flex-wrap: wrap;
  }
  .product-nav a:hover {
    color: var(--accent);
  }
  .prose-grid {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 80px;
  }
  .aside-copy {
    color: var(--muted);
    font-size: 14px;
    margin-top: 20px;
  }
  .prose {
    max-width: 740px;
  }
  .prose :global(h2) {
    font-size: 38px;
    line-height: 1.2;
    margin: 0 0 24px;
    scroll-margin-top: 104px;
  }
  .prose :global(h2:not(:first-child)) {
    margin-top: 80px;
    padding-top: 64px;
    border-top: 1px solid var(--border);
  }
  .prose :global(h3) {
    font-size: 22px;
    margin: 36px 0 14px;
    line-height: 1.3;
  }
  .prose :global(p) {
    font-size: 15px;
    color: var(--muted);
    line-height: 1.85;
    margin-bottom: 18px;
  }
  .prose :global(strong) {
    color: #dedee5;
    font-weight: 600;
  }
  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .prose :global(code) {
    font: 12px var(--mono);
  }
  .prose :global(details) {
    border-bottom: 1px solid var(--border-strong);
  }
  .prose :global(summary) {
    cursor: pointer;
    font-size: 15px;
    padding: 22px 30px 22px 0;
    color: #dedee5;
  }
  .prose :global(summary:hover) {
    color: var(--accent);
  }
  .prose :global(details p) {
    padding: 0 0 6px;
    font-size: 14px;
  }
  .product-cta {
    padding: 0 0 100px;
  }
  .cta-panel {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    padding: 48px;
    background:
      radial-gradient(ellipse at 100% 0%, var(--accent-dim), transparent 65%),
      var(--bg-elev);
    border: 1px solid var(--border-strong);
    border-radius: 16px;
  }
  .cta-panel h2 {
    font-size: 38px;
    margin-top: 20px;
  }
  .cta-panel p:not(.eyebrow) {
    color: var(--muted);
    font-size: 14px;
    margin-top: 20px;
    max-width: 450px;
  }
  @media (max-width: 1024px) {
    .prose-grid {
      grid-template-columns: 190px 1fr;
      gap: 40px;
    }
    .cta-panel {
      align-items: start;
    }
    .cta-panel .actions {
      flex-direction: column;
      flex-shrink: 0;
    }
  }
  @media (max-width: 700px) {
    .privacy-grid {
      display: block;
    }
    .privacy-list {
      margin-top: 32px;
    }
    .product-hero {
      padding-top: 28px;
    }
    .product-heading {
      margin-top: 32px;
      margin-bottom: 22px;
    }
    .product-heading .tag {
      font-size: 9px;
    }
    .product-hero h1 {
      font-size: 44px;
    }
    .product-intro {
      font-size: 16px;
    }
    .desktop-break {
      display: none;
    }
    .availability-note {
      max-width: 300px;
      line-height: 1.8;
    }
    .hero-shot {
      margin-top: 36px;
    }
    .product-nav {
      gap: 20px;
      font-size: 11px;
    }
    .prose-grid {
      display: block;
    }
    aside {
      margin-bottom: 36px;
    }
    .aside-copy {
      display: none;
    }
    .prose :global(h2) {
      font-size: 32px;
    }
    .prose :global(h2:not(:first-child)) {
      margin-top: 56px;
      padding-top: 48px;
    }
    .prose :global(p) {
      font-size: 14px;
    }
    .cta-panel {
      display: block;
      padding: 30px 24px;
    }
    .cta-panel h2 {
      font-size: 32px;
    }
    .cta-panel .actions {
      margin-top: 28px;
      flex-direction: row;
    }
    .product-cta {
      padding-bottom: 64px;
    }
  }
</style>
