---
import Layout from "../../../layouts/Layout.astro";
import Arrow from "../../../components/Arrow.astro";
import { Image } from "astro:assets";
import { mdoc } from "../../../lib/catalog";
import {
  latestMdocRelease,
  mdocAvailability,
  releaseStatusCheckedAt,
} from "../../../lib/releases";
---

<Layout
  title="mdoc downloads & availability | Lawkitt"
  description={
    latestMdocRelease
      ? "Download verified mdoc installers and check platform capabilities, release details and source build requirements."
      : "Check mdoc installer availability, platform feature limits and source build requirements. Public downloads are coming soon."
  }
  socialImage="/social/mdoc.png"
>
  <section class="hero download-page">
    <div class="container narrow">
      <a class="back-link" href="/tools/mdoc/">
        <span aria-hidden="true">←</span> Back to mdoc
      </a>
      <div class="app-label">
        <Image src={mdoc.icon} width={48} height={48} alt="" format="webp" />
        <span>mdoc</span>
      </div>
      <p class="eyebrow">Availability</p>
      <h1>{mdocAvailability}.</h1>
      {latestMdocRelease ? (
        <>
          <p class="download-intro">
            Version {latestMdocRelease.version} — choose a verified installer
            for your platform.
          </p>
          <p class="release-date">
            Published{" "}
            <time datetime={latestMdocRelease.publishedAt}>
              {new Date(
                `${latestMdocRelease.publishedAt}T00:00:00Z`,
              ).toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
                timeZone: "UTC",
              })}
            </time>
          </p>
          <div class="downloads">
            {latestMdocRelease.assets.map((asset) => (
              <article>
                <h2>
                  {asset.platform} <span>{asset.architecture}</span>
                </h2>
                <a
                  class="btn btn-primary"
                  href={asset.url}
                  aria-label={`${asset.label} for ${asset.platform} (${asset.architecture})`}
                >
                  {asset.label} <Arrow />
                </a>
                <details>
                  <summary>SHA-256 checksum</summary>
                  <code>{asset.sha256}</code>
                </details>
              </article>
            ))}
          </div>
          <a class="text-link" href={latestMdocRelease.notesUrl}>
            Release notes <Arrow diagonal />
          </a>
        </>
      ) : (
        <>
          <p class="download-intro">
            The first public release of mdoc is being prepared. To hear the
            moment it’s out, watch the repository on GitHub: choose{" "}
            <strong>Watch → Custom → Releases</strong>. GitHub then notifies you
            about new releases only.
          </p>
          <div class="actions">
            <a class="btn btn-primary" href={mdoc.source}>
              Watch releases on GitHub <Arrow diagonal />
            </a>
            <a class="btn btn-ghost" href="/tools/mdoc/">
              See what mdoc does <Arrow />
            </a>
          </div>
        </>
      )}
      <p class="checked-date">
        Availability checked{" "}
        <time datetime={releaseStatusCheckedAt}>
          {new Date(`${releaseStatusCheckedAt}T00:00:00Z`).toLocaleDateString(
            "en-US",
            { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" },
          )}
        </time>
        .
      </p>
      <div class="source-note">
        <span class="tag tag-accent">For developers</span>
        <h2>A note about source builds</h2>
        <p>
          The code is public and licensed under {mdoc.license}. Its
          dependencies, including the <code>lawkitt/anydoc</code> conversion
          library, are public too, so anyone can build mdoc from source.
        </p>
        <a class="text-link" href={`${mdoc.source}#run`}>
          Read the build requirements <Arrow diagonal />
        </a>
      </div>
      <div class="platform-section">
        <h2>System requirements</h2>
        <ul class="requirements">
          <li>
            <strong>Mac</strong> with Apple silicon (M1 or later).
          </li>
          <li>
            <strong>Windows PC</strong> (x64). Scanned-page recognition also
            needs the free Microsoft Visual C++ Redistributable.
          </li>
          <li>
            <strong>One-time setup</strong> for scan recognition and
            pseudonymization: mdoc asks before downloading its local models,
            then works offline.
          </li>
        </ul>
        <p class="platform-footnote">
          Developers can build mdoc for Intel Macs, Windows on ARM and Linux.
          Those builds read documents with built-in text, but scan recognition
          and automatic pseudonymization are not available there.
        </p>
      </div>
      <div class="help-row">
        <p>A question or a reproducible bug?</p>
        <a class="text-link" href={mdoc.issues}>
          Open the issue tracker <Arrow diagonal />
        </a>
      </div>
    </div>
  </section>
</Layout>
<style>
  .requirements {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
  }
  .requirements li {
    padding: 14px 0;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 14px;
    line-height: 1.7;
  }
  .requirements strong {
    color: var(--fg);
    font-weight: 600;
  }
  .download-intro strong {
    color: var(--fg);
    font-weight: 600;
  }
  .checked-date,
  .release-date {
    color: var(--dim);
    font-size: 11px;
    margin-top: 18px;
  }
  .download-page {
    padding: 40px 0 100px;
  }
  .back-link {
    color: var(--dim);
    font: 11px var(--mono);
    display: inline-flex;
    gap: 8px;
  }
  .back-link:hover {
    color: var(--fg);
  }
  .app-label {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 52px 0 32px;
    font-size: 26px;
    font-weight: 600;
  }
  .app-label img {
    border-radius: 10px;
  }
  h1 {
    margin-top: 18px;
    font-size: clamp(44px, 5.2vw, 64px);
    max-width: 700px;
  }
  .download-intro {
    font-size: 17px;
    color: var(--muted);
    line-height: 1.8;
    max-width: 680px;
    margin: 24px 0 28px;
  }
  .source-note {
    padding: 32px;
    background: var(--bg-elev);
    border: 1px solid var(--border-strong);
    border-radius: 12px;
    margin-top: 48px;
  }
  .source-note h2 {
    font-size: 24px;
    margin: 20px 0 14px;
  }
  .source-note p {
    max-width: 680px;
    font-size: 14px;
    color: var(--muted);
    line-height: 1.85;
  }
  code {
    font: 12px var(--mono);
    color: #c9c9d2;
    overflow-wrap: anywhere;
  }
  .source-note .text-link {
    margin-top: 22px;
  }
  .platform-section {
    margin-top: 60px;
  }
  .platform-section h2 {
    font-size: 30px;
  }
  .platform-section > p {
    color: var(--muted);
    font-size: 13px;
    margin-top: 16px;
    max-width: 720px;
  }
  .platform-section .platform-footnote {
    font-size: 11px;
    line-height: 1.9;
  }
  .help-row {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding-top: 28px;
    margin-top: 40px;
    border-top: 1px solid var(--border);
  }
  .help-row p {
    color: var(--muted);
    font-size: 13px;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .downloads {
    display: grid;
    gap: 20px;
    margin-bottom: 24px;
  }
  .downloads article {
    border: 1px solid var(--border-strong);
    padding: 24px;
    border-radius: 12px;
  }
  .downloads h2 {
    font-size: 24px;
    margin-bottom: 20px;
  }
  .downloads h2 span {
    color: var(--muted);
    font-size: 16px;
  }
  .downloads details {
    margin-top: 18px;
  }
  .downloads summary {
    cursor: pointer;
    color: var(--muted);
    font-size: 12px;
  }
  @media (max-width: 700px) {
    .download-page {
      padding: 28px 0 64px;
    }
    .app-label {
      margin-top: 36px;
    }
    h1 {
      font-size: 44px;
    }
    .download-intro {
      font-size: 15px;
    }
    .source-note {
      padding: 24px;
    }
    .platform-section {
      margin-top: 44px;
    }
    .platform-section h2 {
      font-size: 28px;
    }
    .help-row {
      display: grid;
      gap: 10px;
    }
  }
</style>
