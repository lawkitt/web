---
import Layout from "../layouts/Layout.astro";
import Arrow from "../components/Arrow.astro";
---

<Layout
  title="Page not found | Lawkitt"
  description="This page could not be found. Explore Lawkitt’s free, open-source legal utilities."
  noindex
>
  <section class="hero error-page">
    <div class="container narrow">
      <p class="eyebrow">404 / Page not found</p>
      <h1>A loose end.</h1>
      <p>This page isn’t here. The tools are a good place to start.</p>
      <div class="actions">
        <a class="btn btn-primary" href="/">
          Back to Lawkitt <Arrow />
        </a>
        <a class="btn btn-ghost" href="/mdoc/">
          Explore mdoc <Arrow />
        </a>
      </div>
    </div>
  </section>
</Layout>
<style>
  .error-page {
    padding: 130px 0 160px;
    min-height: 65vh;
  }
  h1 {
    margin-top: 24px;
  }
  .error-page p:not(.eyebrow) {
    color: var(--muted);
    margin: 24px 0 32px;
    font-size: 17px;
  }
  @media (max-width: 700px) {
    .error-page {
      padding: 90px 0 110px;
    }
  }
</style>
