---
import Layout from "../layouts/Layout.astro";
import Arrow from "../components/Arrow.astro";
import ToolCard from "../components/ToolCard.astro";
import Pillars from "../components/Pillars.astro";
import Workflow from "../components/Workflow.astro";
import WorkflowAnimation from "../components/WorkflowAnimation.astro";
import { tools } from "../lib/catalog";
import { latestMdocRelease } from "../lib/releases";
import { SITE } from "../lib/site";
---

<Layout>
  <section class="hero home-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1 data-rise>Free, open-source tools for legal work.</h1>
        <p class="hero-subtitle" data-rise style="--d:.07s">
          We start with <strong>mdoc</strong>: open PDFs, scans and Word files,
          replace client names, and copy clean text into ChatGPT or Claude. It
          all happens on your own computer.
        </p>
        <ul class="facts" data-rise style="--d:.14s">
          <li>
            <span aria-hidden="true">✓</span> Free, no account or subscription
          </li>
          <li>
            <span aria-hidden="true">✓</span> Open source, code on GitHub
          </li>
          <li>
            <span aria-hidden="true">✓</span> mdoc runs locally on Mac and
            Windows
          </li>
        </ul>
        <div class="actions" data-rise style="--d:.21s">
          <a class="btn btn-primary" href="/tools/mdoc/download/">
            Get mdoc <Arrow />
          </a>
          <a class="btn btn-ghost" href="https://github.com/lawkitt/mdoc">
            View the source <Arrow diagonal />
          </a>
        </div>
      </div>
      <div class="hero-anim" data-rise style="--d:.28s">
        <WorkflowAnimation />
      </div>
    </div>
  </section>
  <section class="catalog" id="tools" aria-label="mdoc">
    <div class="container">
      {tools.map((tool, index) => (
        <ToolCard tool={tool} index={index} />
      ))}
    </div>
  </section>
  <section
    class="section"
    id="how-it-works"
    aria-labelledby="how-it-works-title"
  >
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">01 / How it works</p>
          <h2 id="how-it-works-title">Open. Pseudonymize. Copy.</h2>
        </div>
        <p>Three steps. Your judgment stays in charge of each one.</p>
      </div>
      <Workflow />
    </div>
  </section>
  <section class="section" aria-labelledby="pillars-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">02 / Why mdoc</p>
          <h2 id="pillars-title">Built for confidential work.</h2>
        </div>
        <p>
          Nothing leaves your computer until you copy it. Not your documents,
          not your clients’ names.
        </p>
      </div>
      <Pillars />
    </div>
  </section>
  <section class="section principles" aria-labelledby="principles-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">03 / What we build for</p>
          <h2 id="principles-title">Useful by design.</h2>
        </div>
        <p>
          Lawkitt is a collection of practical utilities, shaped around the work
          lawyers actually do.
        </p>
      </div>
      <div class="principles-grid">
        <article>
          <span class="principle-num">01</span>
          <h3>A clear job to do</h3>
          <p>
            Each tool does one task well, so you can pick it up between meetings
            without a manual.
          </p>
        </article>
        <article>
          <span class="principle-num">02</span>
          <h3>Your work stays yours</h3>
          <p>
            mdoc runs on your computer. You decide what is shared, and with
            whom.
          </p>
        </article>
        <article>
          <span class="principle-num">03</span>
          <h3>Free. Open. Inspectable.</h3>
          <p>
            Free to use, with public code anyone can check. Report an issue or
            help make it better on GitHub.
          </p>
        </article>
      </div>
    </div>
  </section>
  <section class="community" aria-labelledby="community-title">
    <div class="container">
      <div class="community-panel">
        <div>
          <p class="eyebrow">04 / Get started</p>
          <h2 id="community-title">
            Ready for your
            <br />
            next document.
          </h2>
          <p>
            {latestMdocRelease
              ? "Download mdoc for your Mac or Windows PC. Free, with no account."
              : "mdoc’s first public release is on its way. Watch the repository on GitHub to hear when it lands."}
          </p>
        </div>
        <div class="actions">
          <a class="btn btn-primary" href="/tools/mdoc/download/">
            Get mdoc <Arrow />
          </a>
          <a class="btn btn-ghost" href={SITE.github}>
            Lawkitt on GitHub <Arrow diagonal />
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
<style>
  .home-hero {
    padding: 72px 0 56px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 540px);
    gap: 56px;
    align-items: center;
  }
  .facts {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 26px 0 0;
    padding: 0;
    color: #d4d4dc;
    font-size: 14px;
  }
  .facts span {
    color: var(--accent);
    margin-right: 6px;
  }
  .catalog {
    padding: 0 0 100px;
  }
  .home-hero h1 {
    font-size: clamp(40px, 4.6vw, 64px);
    text-wrap: balance;
  }
  .hero-subtitle {
    color: var(--muted);
    font-size: 19px;
    line-height: 1.6;
    max-width: 560px;
    margin-top: 26px;
  }
  .hero-subtitle strong {
    color: var(--fg);
    font-weight: 600;
  }
  .home-hero .actions {
    margin-top: 32px;
  }
  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 44px;
    }
  }
  .principles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
  }
  .principle-num {
    font: 11px var(--mono);
    color: var(--accent);
    display: block;
    padding: 16px 0 22px;
    border-top: 1px solid var(--border-strong);
  }
  .principles-grid h3 {
    font-size: 22px;
  }
  .principles-grid p {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.8;
    margin-top: 18px;
  }
  .community {
    padding: 0 0 100px;
  }
  .community-panel .actions {
    flex-shrink: 0;
  }
  .community-panel {
    padding: 48px;
    border: 1px solid var(--border-strong);
    border-radius: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 28px;
    background:
      radial-gradient(ellipse at 95% 0%, var(--accent-dim), transparent 60%),
      var(--bg-elev);
  }
  .community h2 {
    margin-top: 20px;
    font-size: 38px;
  }
  .community p:not(.eyebrow) {
    color: var(--muted);
    max-width: 490px;
    font-size: 14px;
    margin-top: 20px;
  }
  @media (max-width: 1024px) {
    .principles-grid {
      gap: 28px;
    }
  }
  @media (max-width: 700px) {
    .home-hero {
      padding: 48px 0 32px;
    }
    .facts {
      gap: 8px;
      font-size: 13px;
    }
    .catalog {
      padding-bottom: 64px;
    }
    .hero-subtitle {
      font-size: 16px;
      margin-top: 22px;
    }
    .home-hero .actions {
      gap: 10px;
    }
    .home-hero .btn {
      padding: 12px 16px;
      font-size: 12px;
    }
    .principles-grid {
      display: block;
    }
    .principles-grid article + article {
      margin-top: 32px;
    }
    .community {
      padding-bottom: 64px;
    }
    .community-panel {
      display: block;
      padding: 30px 24px;
    }
    .community h2 {
      font-size: 32px;
    }
    .community .actions {
      margin-top: 28px;
    }
  }
</style>
