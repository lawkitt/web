---
import Layout from "../layouts/Layout.astro";
import Arrow from "../components/Arrow.astro";
import ToolCard from "../components/ToolCard.astro";
import { tools } from "../lib/catalog";
import { SITE } from "../lib/site";
---

<Layout>
  <section class="hero home-hero">
    <div class="container">
      <div class="hero-label" data-rise>
        <span class="status-dot"></span> Made for the work between the big
        decisions
      </div>
      <h1 data-rise style="--d:.07s">
        Practical tools for
        <br class="desktop-break" /> everyday legal work.
      </h1>
      <p class="hero-subtitle" data-rise style="--d:.14s">
        Free, open-source utilities from Lawkitt.
      </p>
      <div class="actions" data-rise style="--d:.21s">
        <a class="btn btn-primary" href="/tools/mdoc/">
          Explore mdoc <Arrow />
        </a>
        <a class="btn btn-ghost" href={SITE.github}>
          Browse on GitHub <Arrow diagonal />
        </a>
      </div>
      <a class="catalog-cue" href="#tools">
        Meet the tools <span aria-hidden="true">↓</span>
      </a>
    </div>
  </section>
  <section class="section catalog" id="tools" aria-labelledby="catalog-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">01 / The collection</p>
          <h2 id="catalog-title">One task. A better tool.</h2>
        </div>
        <p>
          Focused software we build for everyday legal workflows. Starting with
          documents.
        </p>
      </div>
      {tools.map((tool, index) => (
        <ToolCard tool={tool} index={index} />
      ))}
    </div>
  </section>
  <section class="section principles" aria-labelledby="principles-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">02 / What we build for</p>
          <h2 id="principles-title">Useful by design.</h2>
        </div>
        <p>
          Lawkitt is a collection of practical utilities, shaped around the work
          lawyers actually do.
        </p>
      </div>
      <div class="principles-grid">
        <article>
          <span class="principle-num">01</span>
          <h3>A clear job to do</h3>
          <p>
            Prepare a document. Check the result. Move on with your work. Each
            utility starts with a specific task.
          </p>
        </article>
        <article>
          <span class="principle-num">02</span>
          <h3>Your work, under your control</h3>
          <p>
            mdoc processes documents locally. You decide what to edit, save and
            share with another tool.
          </p>
        </article>
        <article>
          <span class="principle-num">03</span>
          <h3>Free. Open. Inspectable.</h3>
          <p>
            Our software is free and its code is public. Follow development,
            report an issue or help make it better.
          </p>
        </article>
      </div>
    </div>
  </section>
  <section class="community" aria-labelledby="community-title">
    <div class="container">
      <div class="community-panel">
        <div>
          <p class="eyebrow">03 / Build with us</p>
          <h2 id="community-title">
            Good tools grow
            <br />
            with real work.
          </h2>
          <p>
            Bring a reproducible bug, a practical use case or a contribution.
            Development happens on GitHub.
          </p>
        </div>
        <a class="btn btn-ghost" href={SITE.github}>
          Find us on GitHub <Arrow diagonal />
        </a>
      </div>
    </div>
  </section>
</Layout>
<style>
  .home-hero {
    padding: 112px 0 62px;
    text-align: center;
  }
  .hero-label {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--muted);
    font: 11px var(--mono);
    margin-bottom: 27px;
  }
  .status-dot {
    width: 6px;
    height: 6px;
    background: var(--accent);
    border-radius: 50%;
    box-shadow: 0 0 15px var(--accent-dim);
  }
  .home-hero h1 {
    max-width: 1000px;
    margin: 0 auto;
  }
  .hero-subtitle {
    color: var(--muted);
    font-size: 19px;
    margin-top: 28px;
  }
  .home-hero .actions {
    justify-content: center;
    margin-top: 32px;
  }
  .catalog-cue {
    display: inline-flex;
    gap: 12px;
    margin-top: 66px;
    color: var(--dim);
    font: 10px var(--mono);
  }
  .catalog-cue:hover {
    color: var(--fg);
  }
  .principles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
  }
  .principle-num {
    font: 11px var(--mono);
    color: var(--accent);
    display: block;
    padding: 16px 0 22px;
    border-top: 1px solid var(--border-strong);
  }
  .principles-grid h3 {
    font-size: 22px;
  }
  .principles-grid p {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.8;
    margin-top: 18px;
  }
  .community {
    padding: 0 0 100px;
  }
  .community-panel {
    padding: 48px;
    border: 1px solid var(--border-strong);
    border-radius: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 28px;
    background:
      radial-gradient(ellipse at 95% 0%, var(--accent-dim), transparent 60%),
      var(--bg-elev);
  }
  .community h2 {
    margin-top: 20px;
    font-size: 38px;
  }
  .community p:not(.eyebrow) {
    color: var(--muted);
    max-width: 490px;
    font-size: 14px;
    margin-top: 20px;
  }
  @media (max-width: 1024px) {
    .principles-grid {
      gap: 28px;
    }
  }
  @media (max-width: 700px) {
    .home-hero {
      padding: 72px 0 42px;
    }
    .hero-label {
      font-size: 9px;
      max-width: 285px;
      line-height: 1.7;
      text-align: left;
    }
    .desktop-break {
      display: none;
    }
    .hero-subtitle {
      font-size: 16px;
      max-width: 280px;
      margin: 24px auto 0;
    }
    .home-hero .actions {
      gap: 10px;
    }
    .home-hero .btn {
      padding: 12px 16px;
      font-size: 12px;
    }
    .catalog-cue {
      margin-top: 42px;
    }
    .principles-grid {
      display: block;
    }
    .principles-grid article + article {
      margin-top: 32px;
    }
    .community {
      padding-bottom: 64px;
    }
    .community-panel {
      display: block;
      padding: 30px 24px;
    }
    .community h2 {
      font-size: 32px;
    }
    .community .btn {
      margin-top: 28px;
    }
  }
</style>
