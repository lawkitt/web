---
import Layout from "../layouts/Layout.astro";
import Arrow from "../components/Arrow.astro";
import ToolCard from "../components/ToolCard.astro";
import Pillars from "../components/Pillars.astro";
import Workflow from "../components/Workflow.astro";
import { tools } from "../lib/catalog";
import { latestMdocRelease } from "../lib/releases";
import { SITE } from "../lib/site";
---

<Layout>
  <section class="hero home-hero">
    <div class="container">
      <div class="hero-label" data-rise>
        <span class="status-dot"></span> Free & open source · Runs on your
        computer
      </div>
      <h1 data-rise style="--d:.07s">
        Practical tools for
        <br class="desktop-break" /> everyday legal work.
      </h1>
      <p class="hero-subtitle" data-rise style="--d:.14s">
        Our first tool, <strong>mdoc</strong>, gets your PDFs, scans and Word
        files ready for ChatGPT or Claude, with client names replaced before
        anything leaves your computer.
      </p>
      <div class="actions" data-rise style="--d:.21s">
        <a class="btn btn-primary" href="/tools/mdoc/download/">
          Get mdoc <Arrow />
        </a>
        <a class="btn btn-ghost" href="#how-it-works">
          See how it works <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
  </section>
  <section class="section catalog" id="tools" aria-labelledby="catalog-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">01 / Our first tool</p>
          <h2 id="catalog-title">Prepare legal documents for AI. Privately.</h2>
        </div>
        <p>
          Lawkitt builds focused, free utilities for the everyday work of
          lawyers. We start with documents.
        </p>
      </div>
      {tools.map((tool, index) => (
        <ToolCard tool={tool} index={index} />
      ))}
    </div>
  </section>
  <section
    class="section"
    id="how-it-works"
    aria-labelledby="how-it-works-title"
  >
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">02 / How it works</p>
          <h2 id="how-it-works-title">Open. Pseudonymize. Copy.</h2>
        </div>
        <p>Three steps. Your judgment stays in charge of each one.</p>
      </div>
      <Workflow />
    </div>
  </section>
  <section class="section" aria-labelledby="pillars-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">03 / Why mdoc</p>
          <h2 id="pillars-title">Built for confidential work.</h2>
        </div>
        <p>
          Nothing leaves your computer until you copy it. Not your documents,
          not your clients’ names.
        </p>
      </div>
      <Pillars />
    </div>
  </section>
  <section class="section principles" aria-labelledby="principles-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">04 / What we build for</p>
          <h2 id="principles-title">Useful by design.</h2>
        </div>
        <p>
          Lawkitt is a collection of practical utilities, shaped around the work
          lawyers actually do.
        </p>
      </div>
      <div class="principles-grid">
        <article>
          <span class="principle-num">01</span>
          <h3>A clear job to do</h3>
          <p>
            Each tool does one task well, so you can pick it up between meetings
            without a manual.
          </p>
        </article>
        <article>
          <span class="principle-num">02</span>
          <h3>Your work stays yours</h3>
          <p>
            Our tools run on your computer. You decide what is shared, and with
            whom.
          </p>
        </article>
        <article>
          <span class="principle-num">03</span>
          <h3>Free. Open. Inspectable.</h3>
          <p>
            Free to use, with public code anyone can check. Report an issue or
            help make it better on GitHub.
          </p>
        </article>
      </div>
    </div>
  </section>
  <section class="community" aria-labelledby="community-title">
    <div class="container">
      <div class="community-panel">
        <div>
          <p class="eyebrow">05 / Get started</p>
          <h2 id="community-title">
            Ready for your
            <br />
            next document.
          </h2>
          <p>
            {latestMdocRelease
              ? "Download mdoc for your Mac or Windows PC. Free, with no account."
              : "mdoc’s first public release is on its way. Watch the repository on GitHub to hear when it lands."}
          </p>
        </div>
        <div class="actions">
          <a class="btn btn-primary" href="/tools/mdoc/download/">
            Get mdoc <Arrow />
          </a>
          <a class="btn btn-ghost" href={SITE.github}>
            Lawkitt on GitHub <Arrow diagonal />
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
<style>
  .home-hero {
    padding: 112px 0 62px;
    text-align: center;
  }
  .hero-label {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--muted);
    font: 11px var(--mono);
    margin-bottom: 27px;
  }
  .status-dot {
    width: 6px;
    height: 6px;
    background: var(--accent);
    border-radius: 50%;
    box-shadow: 0 0 15px var(--accent-dim);
  }
  .home-hero h1 {
    max-width: 1000px;
    margin: 0 auto;
  }
  .hero-subtitle {
    color: var(--muted);
    font-size: 19px;
    line-height: 1.6;
    max-width: 640px;
    margin: 28px auto 0;
  }
  .hero-subtitle strong {
    color: var(--fg);
    font-weight: 600;
  }
  .home-hero .actions {
    justify-content: center;
    margin-top: 32px;
  }
  .principles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
  }
  .principle-num {
    font: 11px var(--mono);
    color: var(--accent);
    display: block;
    padding: 16px 0 22px;
    border-top: 1px solid var(--border-strong);
  }
  .principles-grid h3 {
    font-size: 22px;
  }
  .principles-grid p {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.8;
    margin-top: 18px;
  }
  .community {
    padding: 0 0 100px;
  }
  .community-panel .actions {
    flex-shrink: 0;
  }
  .community-panel {
    padding: 48px;
    border: 1px solid var(--border-strong);
    border-radius: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 28px;
    background:
      radial-gradient(ellipse at 95% 0%, var(--accent-dim), transparent 60%),
      var(--bg-elev);
  }
  .community h2 {
    margin-top: 20px;
    font-size: 38px;
  }
  .community p:not(.eyebrow) {
    color: var(--muted);
    max-width: 490px;
    font-size: 14px;
    margin-top: 20px;
  }
  @media (max-width: 1024px) {
    .principles-grid {
      gap: 28px;
    }
  }
  @media (max-width: 700px) {
    .home-hero {
      padding: 72px 0 42px;
    }
    .hero-label {
      font-size: 9px;
      max-width: 285px;
      line-height: 1.7;
      text-align: left;
    }
    .desktop-break {
      display: none;
    }
    .hero-subtitle {
      font-size: 16px;
      margin: 24px auto 0;
    }
    .home-hero .actions {
      gap: 10px;
    }
    .home-hero .btn {
      padding: 12px 16px;
      font-size: 12px;
    }
    .principles-grid {
      display: block;
    }
    .principles-grid article + article {
      margin-top: 32px;
    }
    .community {
      padding-bottom: 64px;
    }
    .community-panel {
      display: block;
      padding: 30px 24px;
    }
    .community h2 {
      font-size: 32px;
    }
    .community .actions {
      margin-top: 28px;
    }
  }
</style>
