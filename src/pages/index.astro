---
import Layout from "../layouts/Layout.astro";
import Arrow from "../components/Arrow.astro";
import ToolCard from "../components/ToolCard.astro";
import WorkflowAnimation from "../components/WorkflowAnimation.astro";
import { tools } from "../lib/catalog";
---

<Layout>
  <section class="hero home-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1 data-rise>Free, open-source tools for legal work.</h1>
        <p class="hero-subtitle" data-rise style="--d:.07s">
          We start with <strong>mdoc</strong>: open PDFs, scans and Word files,
          replace client names, and copy clean text into ChatGPT or Claude. It
          all happens on your own computer.
        </p>
        <ul class="facts" data-rise style="--d:.14s">
          <li>
            <span aria-hidden="true">✓</span> Free, no account or subscription
          </li>
          <li>
            <span aria-hidden="true">✓</span> Open source, code on GitHub
          </li>
          <li>
            <span aria-hidden="true">✓</span> mdoc runs locally on Mac and
            Windows
          </li>
        </ul>
        <div class="actions" data-rise style="--d:.21s">
          <a class="btn btn-primary" href="/mdoc/">
            Get mdoc <Arrow />
          </a>
          <a class="btn btn-ghost" href="https://github.com/lawkitt/mdoc">
            View the source <Arrow diagonal />
          </a>
        </div>
      </div>
      <div class="hero-anim" data-rise style="--d:.28s">
        <WorkflowAnimation />
      </div>
    </div>
  </section>
  <section class="catalog" id="tools" aria-label="mdoc">
    <div class="container">
      {tools.map((tool, index) => (
        <ToolCard tool={tool} index={index} />
      ))}
    </div>
  </section>
  <section class="section principles" aria-labelledby="principles-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">What we build</p>
          <h2 id="principles-title">Open tools for AI-native lawyers.</h2>
        </div>
        <p>
          Lawyers already work with AI assistants. We build the free utilities
          around them, in the open.
        </p>
      </div>
      <div class="principles-grid">
        <article>
          <span class="principle-num">01</span>
          <h3>Made for working with AI</h3>
          <p>
            Our tools prepare your work for the assistants you already use, such
            as ChatGPT or Claude. They don’t try to replace them.
          </p>
        </article>
        <article>
          <span class="principle-num">02</span>
          <h3>Confidential by design</h3>
          <p>
            mdoc runs on your computer. Nothing is shared until you choose to
            copy it.
          </p>
        </article>
        <article>
          <span class="principle-num">03</span>
          <h3>Free and open source</h3>
          <p>
            No subscription and no account. The code is public: check it, report
            an issue or contribute on GitHub.
          </p>
        </article>
      </div>
    </div>
  </section>
</Layout>
<style>
  .home-hero {
    padding: 72px 0 56px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 540px);
    gap: 56px;
    align-items: center;
  }
  .facts {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 26px 0 0;
    padding: 0;
    color: #d4d4dc;
    font-size: 14px;
  }
  .facts span {
    color: var(--accent);
    margin-right: 6px;
  }
  .catalog {
    padding: 0 0 100px;
  }
  .home-hero h1 {
    font-size: clamp(40px, 4.6vw, 64px);
    text-wrap: balance;
  }
  .hero-subtitle {
    color: var(--muted);
    font-size: 19px;
    line-height: 1.6;
    max-width: 560px;
    margin-top: 26px;
  }
  .hero-subtitle strong {
    color: var(--fg);
    font-weight: 600;
  }
  .home-hero .actions {
    margin-top: 32px;
  }
  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 44px;
    }
  }
  .principles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
  }
  .principle-num {
    font: 11px var(--mono);
    color: var(--accent);
    display: block;
    padding: 16px 0 22px;
    border-top: 1px solid var(--border-strong);
  }
  .principles-grid h3 {
    font-size: 22px;
  }
  .principles-grid p {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.8;
    margin-top: 18px;
  }
  @media (max-width: 1024px) {
    .principles-grid {
      gap: 28px;
    }
  }
  @media (max-width: 700px) {
    .home-hero {
      padding: 48px 0 32px;
    }
    .facts {
      gap: 8px;
      font-size: 13px;
    }
    .catalog {
      padding-bottom: 64px;
    }
    .hero-subtitle {
      font-size: 16px;
      margin-top: 22px;
    }
    .home-hero .actions {
      gap: 10px;
    }
    .home-hero .btn {
      padding: 12px 16px;
      font-size: 12px;
    }
    .principles-grid {
      display: block;
    }
    .principles-grid article + article {
      margin-top: 32px;
    }
  }
</style>
