---
import Arrow from "./Arrow.astro";
---

<ol class="steps">
  <li>
    <div class="step-visual">
      <span class="file-pill">.pdf</span>
      <span class="file-pill">.docx</span>
      <span class="file-pill">scan</span>
    </div>
    <div class="step-title">
      <span>01</span>
      <h3>Open</h3>
    </div>
    <p>
      Drop in a PDF, a scan or a Word file. mdoc turns it into clean, editable
      text and keeps the original beside it so you can check every line.
    </p>
  </li>
  <li>
    <div class="step-visual compare">
      <span class="redact">Alice Morgan</span>
      <Arrow />
      <span class="alias">PERSON_1</span>
    </div>
    <div class="step-title">
      <span>02</span>
      <h3>Pseudonymize</h3>
    </div>
    <p>
      mdoc highlights client names and other identifiers and suggests
      replacements. You review and approve every one. Nothing changes until you
      do.
    </p>
  </li>
  <li>
    <div class="step-visual">
      <span class="copy-label">Copy</span>
      <Arrow />
      <span class="file-pill prepared">ChatGPT · Claude</span>
    </div>
    <div class="step-title">
      <span>03</span>
      <h3>Copy</h3>
    </div>
    <p>
      Copy the prepared text in Markdown, the plain format AI assistants read
      best, and paste it into the tool you already use, such as ChatGPT or
      Claude.
    </p>
  </li>
</ol>
<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .steps li {
    border-top: 1px solid var(--border-strong);
    padding-top: 28px;
  }
  .step-visual {
    height: 110px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 8px;
    margin-bottom: 28px;
    color: var(--dim);
  }
  .file-pill {
    font: 12px var(--mono);
    background: #1a1a20;
    color: #c1c1cc;
    border: 1px solid var(--border-strong);
    padding: 8px;
    border-radius: 5px;
  }
  .prepared,
  .alias {
    color: var(--accent);
    border-color: oklch(0.68 0.17 250 / 0.35);
    background: var(--accent-dim);
  }
  .redact,
  .alias {
    font: 12px var(--mono);
    padding: 6px 8px;
    border-radius: 4px;
    border: 1px solid;
  }
  .redact {
    color: #e8cf8f;
    background: #d3b46b1c;
    border-color: #d3b46b55;
  }
  .copy-label {
    color: #c1c1cc;
    font: 11px var(--mono);
  }
  .step-title {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .step-title > span {
    color: var(--accent);
    font: 11px var(--mono);
  }
  .steps p {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.8;
    margin-top: 18px;
  }
  @media (max-width: 700px) {
    .steps {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .step-visual {
      height: 95px;
      margin-bottom: 22px;
    }
  }
</style>
