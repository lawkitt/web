---
import { Image } from "astro:assets";
import openai from "../assets/ai/openai.svg?raw";
import claude from "../assets/ai/claude.svg?raw";
import { mdoc } from "../lib/catalog";
// ADR 0005: document → mdoc (parse, pseudonymize, approve) → ChatGPT or Claude.
// Pure CSS keyframes on one shared loop; a tiny script only scales the fixed
// 560 × 470 stage to its column and pauses it offscreen.
---

<div
  class="flow"
  role="img"
  aria-label="A PDF or Word contract opens in mdoc on your computer. mdoc turns it into clean text, replaces client names with aliases such as PERSON_1 that you approve, and the prepared text is copied into ChatGPT or Claude."
>
  <div class="stage" aria-hidden="true">
    <div class="card doc">
      <div class="kind">
        <span class="pdf">PDF</span>
        <span class="docx">DOCX</span>
      </div>
      <div class="ln" style="width:92%"></div>
      <div class="ln nm" style="width:70%"></div>
      <div class="ln" style="width:84%"></div>
      <div class="ln nm" style="width:58%"></div>
      <div class="ln" style="width:90%"></div>
      <div class="ln" style="width:76%"></div>
      <div class="ln nm" style="width:64%"></div>
      <div class="ln" style="width:40%"></div>
    </div>

    <div class="card win">
      <div class="titlebar">
        <span class="dots">
          <i></i>
          <i></i>
          <i></i>
        </span>
        <Image src={mdoc.icon} alt="" width={36} height={36} format="webp" />
        <b>mdoc</b>
        <span class="status">
          <span class="st0">Share Purchase Agreement</span>
          <span class="st1">Reading…</span>
          <span class="st2">Review each name</span>
          <span class="st3">✓ 3 approved</span>
        </span>
        <span class="copy">Copy</span>
      </div>
      <div class="body">
        <div class="empty">Drop a PDF or Word file</div>
        <div class="raw">
          <div class="ln" style="width:62%"></div>
          <div class="ln" style="width:94%"></div>
          <div class="ln" style="width:88%"></div>
          <div class="ln" style="width:91%"></div>
          <div class="ln" style="width:70%"></div>
          <div class="ln" style="width:83%"></div>
        </div>
        <div class="scan"></div>
        <div class="md title">
          <span class="h"># </span>Share Purchase Agreement
        </div>
        <div class="md">
          <span class="k">Seller</span>
          <span class="name">
            <span class="orig">Eleanor Whitcombe</span>
            <span class="alias">
              PERSON_1<span class="tick">✓</span>
            </span>
          </span>
        </div>
        <div class="md">
          <span class="k">Buyer</span>
          <span class="name n2">
            <span class="orig">Halvorsen Maritime</span>
            <span class="alias">
              ORG_1<span class="tick n2">✓</span>
            </span>
          </span>
        </div>
        <div class="md">
          <span class="k">Director</span>
          <span class="name n3">
            <span class="orig">Daniel Okafor</span>
            <span class="alias">
              PERSON_2<span class="tick n3">✓</span>
            </span>
          </span>
        </div>
        <div class="md">
          <span class="h">- </span>Price: GBP 1,250,000
        </div>
      </div>
    </div>

    <div class="card packet">
      <i></i> Markdown
    </div>

    <div class="card ai">
      <div class="head">
        <div class="who gpt">
          <Fragment set:html={openai} /> ChatGPT
        </div>
        <div class="who claude">
          <Fragment set:html={claude} /> Claude
        </div>
      </div>
      <div class="bubble">
        <div class="p">Summarize the key risks:</div>
        Seller <span class="a">PERSON_1</span> sells to{" "}
        <span class="a">ORG_1</span>; director <span class="a">PERSON_2</span>{" "}
        resigns…
      </div>
    </div>
  </div>
</div>

<script>
  for (const flow of document.querySelectorAll<HTMLElement>(".flow")) {
    new ResizeObserver(([entry]) => {
      flow.style.setProperty("--s", String(entry!.contentRect.width / 560));
    }).observe(flow);
    new IntersectionObserver(([entry]) => {
      flow.classList.toggle("paused", !entry!.isIntersecting);
    }).observe(flow);
  }
</script>

<style>
  .flow {
    --t: 9s;
    --amber: #e8cf8f;
    --amber-bg: #d3b46b26;
    --amber-border: #d3b46b66;
    --ok: #7ee2a8;
    position: relative;
    width: 100%;
    max-width: 520px;
    margin: 0 auto;
    aspect-ratio: 560 / 470;
    overflow: hidden;
  }
  .stage {
    position: absolute;
    top: 0;
    left: 0;
    width: 560px;
    height: 470px;
    transform-origin: 0 0;
    transform: scale(var(--s, 1));
  }
  .stage * {
    animation-duration: var(--t);
    animation-iteration-count: infinite;
    animation-fill-mode: both;
    animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  }
  .paused .stage * {
    animation-play-state: paused;
  }
  .card {
    position: absolute;
    background: var(--bg-card);
    border: 1px solid var(--border-strong);
    border-radius: 12px;
    box-shadow: 0 24px 80px #0007;
  }

  .doc {
    left: 0;
    top: 18px;
    width: 158px;
    height: 196px;
    padding: 16px 14px;
    z-index: 3;
    animation-name: wf-doc;
  }
  .kind {
    position: relative;
    height: 22px;
    margin-bottom: 14px;
  }
  .kind span {
    position: absolute;
    left: 0;
    top: 0;
    font: 600 10px var(--mono);
    letter-spacing: 0.06em;
    padding: 4px 7px;
    border-radius: 4px;
    animation-duration: calc(var(--t) * 2);
  }
  .kind .pdf {
    background: #e5484d22;
    color: #ff8a8e;
    border: 1px solid #e5484d55;
    animation-name: wf-first-half;
  }
  .kind .docx {
    background: #3e7bfa22;
    color: #8db2ff;
    border: 1px solid #3e7bfa55;
    animation-name: wf-second-half;
  }
  .doc .ln {
    height: 6px;
    border-radius: 3px;
    background: #ffffff1c;
    margin: 9px 0;
  }
  .doc .nm {
    background: #ffffff2e;
  }

  .win {
    left: 92px;
    top: 92px;
    width: 372px;
    height: 268px;
    z-index: 2;
    overflow: hidden;
    animation-name: wf-win;
  }
  .titlebar {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 38px;
    padding: 0 12px;
    border-bottom: 1px solid var(--border);
    font: 11px var(--mono);
    color: var(--muted);
  }
  .titlebar img {
    width: 18px;
    height: 18px;
    border-radius: 5px;
  }
  .titlebar b {
    color: var(--fg);
    font-weight: 500;
  }
  .dots {
    display: flex;
    gap: 5px;
    margin-right: 4px;
  }
  .dots i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ffffff22;
  }
  .status {
    position: relative;
    flex: 1;
    height: 16px;
    font-size: 10px;
  }
  .status span {
    position: absolute;
    left: 0;
    top: 0;
    white-space: nowrap;
  }
  .st0 {
    animation-name: wf-st0;
  }
  .st1 {
    animation-name: wf-st1;
  }
  .st2 {
    color: var(--amber);
    animation-name: wf-st2;
  }
  .st3 {
    color: var(--ok);
    animation-name: wf-st3;
  }
  .copy {
    font: 10px var(--mono);
    padding: 4px 8px;
    border-radius: 5px;
    border: 1px solid var(--border-strong);
    color: var(--muted);
    animation-name: wf-copy;
  }
  .body {
    position: relative;
    padding: 18px;
    height: 228px;
  }
  .empty {
    position: absolute;
    inset: 18px;
    display: grid;
    place-items: center;
    border: 1px dashed var(--border-strong);
    border-radius: 8px;
    color: var(--dim);
    font: 11px var(--mono);
    animation-name: wf-empty;
  }
  .raw {
    position: absolute;
    inset: 18px;
    animation-name: wf-raw;
  }
  .raw .ln {
    height: 6px;
    border-radius: 3px;
    background: #ffffff1a;
    margin: 0 0 14px;
  }
  .scan {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 36px;
    z-index: 2;
    background: linear-gradient(
      to bottom,
      transparent,
      oklch(0.68 0.17 250 / 0.22) 80%,
      oklch(0.68 0.17 250 / 0.8)
    );
    border-bottom: 1px solid var(--accent);
    animation-name: wf-scan;
  }
  .md {
    font: 12px/2 var(--mono);
    color: #d4d4dc;
    white-space: nowrap;
    animation-name: wf-md;
  }
  .md:nth-of-type(5) {
    animation-delay: 0.08s;
  }
  .md:nth-of-type(6) {
    animation-delay: 0.16s;
  }
  .md:nth-of-type(7) {
    animation-delay: 0.24s;
  }
  .md:nth-of-type(8) {
    animation-delay: 0.32s;
  }
  .md.title {
    font: 600 15px/2 var(--font);
    color: var(--fg);
    letter-spacing: -0.01em;
  }
  .h {
    color: var(--accent);
  }
  .k {
    display: inline-block;
    width: 72px;
    color: var(--dim);
  }
  .name {
    display: inline-grid;
    vertical-align: bottom;
  }
  .name > span {
    grid-area: 1 / 1;
    justify-self: start;
    padding: 0 5px;
    border-radius: 4px;
    border: 1px solid transparent;
  }
  .orig {
    animation-name: wf-orig;
  }
  .alias {
    color: var(--accent);
    background: var(--accent-dim);
    border-color: oklch(0.68 0.17 250 / 0.35) !important;
    animation-name: wf-alias;
  }
  .alias {
    position: relative;
  }
  .tick {
    position: absolute;
    left: 100%;
    top: 0;
    margin-left: 7px;
    font-size: 10px;
    color: var(--ok);
    animation-name: wf-tick;
  }
  .n2,
  .n2 > span {
    animation-delay: 0.45s;
  }
  .n3,
  .n3 > span {
    animation-delay: 0.9s;
  }

  .packet {
    left: 380px;
    top: 104px;
    width: 92px;
    height: 30px;
    z-index: 5;
    border-radius: 8px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 9px;
    font: 10px var(--mono);
    color: var(--accent);
    background: #12141c;
    border-color: oklch(0.68 0.17 250 / 0.5);
    animation-name: wf-packet;
  }
  .packet i {
    width: 18px;
    height: 4px;
    border-radius: 2px;
    background: oklch(0.68 0.17 250 / 0.6);
    box-shadow: 0 7px 0 oklch(0.68 0.17 250 / 0.35);
    transform: translateY(-3px);
  }

  .ai {
    left: 248px;
    top: 300px;
    width: 312px;
    height: 158px;
    z-index: 4;
    animation-name: wf-ai;
  }
  .head {
    position: relative;
    height: 40px;
    border-bottom: 1px solid var(--border);
  }
  .who {
    position: absolute;
    left: 12px;
    top: 0;
    height: 40px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 500;
    animation-duration: calc(var(--t) * 2);
  }
  .who :global(svg) {
    width: 18px;
    height: 18px;
  }
  .gpt {
    animation-name: wf-first-half;
  }
  .claude {
    animation-name: wf-second-half;
  }
  .bubble {
    margin: 14px 12px 0 auto;
    width: 236px;
    padding: 10px 12px;
    border-radius: 12px 12px 4px 12px;
    background: #1b1d27;
    border: 1px solid var(--border-strong);
    font: 10.5px/1.7 var(--mono);
    color: #c9c9d2;
    animation-name: wf-bubble;
  }
  .bubble .a {
    color: var(--accent);
  }
  .bubble .p {
    font: 12px var(--font);
    color: var(--fg);
    margin-bottom: 4px;
  }

  /* Without motion, the base styles form one static summary frame. */
  .empty,
  .raw,
  .scan,
  .packet,
  .orig,
  .st0,
  .st1,
  .st2,
  .kind .docx,
  .claude {
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .stage,
    .stage * {
      animation: none !important;
    }
    .doc {
      transform: translate(-4px, -16px) scale(0.72);
      transform-origin: 0 0;
    }
  }

  @keyframes wf-doc {
    0% {
      opacity: 0;
      transform: translateX(-18px);
    }
    6%,
    15% {
      opacity: 1;
      transform: none;
    }
    25%,
    100% {
      opacity: 0;
      transform: translate(190px, 150px) scale(0.3);
    }
  }
  @keyframes wf-win {
    0%,
    21% {
      border-color: var(--border-strong);
    }
    25% {
      border-color: var(--accent);
    }
    34%,
    100% {
      border-color: var(--border-strong);
    }
  }
  @keyframes wf-empty {
    0%,
    18% {
      opacity: 1;
    }
    23%,
    100% {
      opacity: 0;
    }
  }
  @keyframes wf-raw {
    0%,
    22% {
      opacity: 0;
    }
    25%,
    33% {
      opacity: 1;
    }
    38%,
    100% {
      opacity: 0;
    }
  }
  @keyframes wf-scan {
    0%,
    25% {
      opacity: 0;
      transform: translateY(-36px);
    }
    26% {
      opacity: 1;
      transform: translateY(-36px);
    }
    37% {
      opacity: 1;
      transform: translateY(228px);
    }
    39%,
    100% {
      opacity: 0;
      transform: translateY(228px);
    }
  }
  @keyframes wf-md {
    0%,
    32% {
      opacity: 0;
      transform: translateY(5px);
    }
    37%,
    93% {
      opacity: 1;
      transform: none;
    }
    98%,
    100% {
      opacity: 0;
      transform: none;
    }
  }
  @keyframes wf-orig {
    0%,
    41% {
      color: inherit;
      background: transparent;
      border-color: transparent;
      opacity: 1;
    }
    44%,
    50% {
      color: var(--amber);
      background: var(--amber-bg);
      border-color: var(--amber-border);
      opacity: 1;
    }
    54%,
    100% {
      color: var(--amber);
      background: var(--amber-bg);
      border-color: var(--amber-border);
      opacity: 0;
    }
  }
  @keyframes wf-alias {
    0%,
    50% {
      opacity: 0;
      transform: scale(0.85);
    }
    55%,
    100% {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes wf-tick {
    0%,
    55% {
      opacity: 0;
      transform: scale(0.4);
    }
    59%,
    100% {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes wf-st0 {
    0%,
    22% {
      opacity: 1;
    }
    24%,
    95% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }
  @keyframes wf-st1 {
    0%,
    24% {
      opacity: 0;
    }
    26%,
    39% {
      opacity: 1;
    }
    41%,
    100% {
      opacity: 0;
    }
  }
  @keyframes wf-st2 {
    0%,
    40% {
      opacity: 0;
    }
    42%,
    61% {
      opacity: 1;
    }
    63%,
    100% {
      opacity: 0;
    }
  }
  @keyframes wf-st3 {
    0%,
    62% {
      opacity: 0;
    }
    64%,
    93% {
      opacity: 1;
    }
    96%,
    100% {
      opacity: 0;
    }
  }
  @keyframes wf-copy {
    0%,
    63% {
      color: var(--muted);
      background: transparent;
      border-color: var(--border-strong);
    }
    65%,
    68% {
      color: var(--bg);
      background: var(--fg);
      border-color: var(--fg);
    }
    72%,
    100% {
      color: var(--muted);
      background: transparent;
      border-color: var(--border-strong);
    }
  }
  @keyframes wf-packet {
    0%,
    66% {
      opacity: 0;
      transform: scale(0.6);
    }
    68% {
      opacity: 1;
      transform: none;
    }
    78% {
      opacity: 1;
      transform: translate(-44px, 268px) scale(0.9);
    }
    81%,
    100% {
      opacity: 0;
      transform: translate(-44px, 268px) scale(0.6);
    }
  }
  @keyframes wf-ai {
    0%,
    76% {
      border-color: var(--border-strong);
    }
    80% {
      border-color: var(--accent);
    }
    88%,
    100% {
      border-color: var(--border-strong);
    }
  }
  @keyframes wf-bubble {
    0%,
    78% {
      opacity: 0;
      transform: translateY(8px);
    }
    82%,
    94% {
      opacity: 1;
      transform: none;
    }
    99%,
    100% {
      opacity: 0;
      transform: none;
    }
  }
  @keyframes wf-first-half {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    99.9% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }
  @keyframes wf-second-half {
    0%,
    49% {
      opacity: 0;
    }
    50%,
    99.9% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
</style>
