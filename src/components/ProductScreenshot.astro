---
import { Image } from "astro:assets";
import { mdoc, type Tool } from "../lib/catalog";
interface Props {
  compact?: boolean;
  tool?: Tool;
}
const { compact = false, tool = mdoc } = Astro.props;
const captures = compact
  ? tool.captures.filter((capture) => capture.id === "review")
  : tool.captures;
// Open on Review, the richest view; the tabs keep the story order.
const initial = Math.max(
  captures.findIndex((capture) => capture.id === "review"),
  0,
);
---

<figure class:list={["product-shot", { compact }]} data-product-shot>
  <div class="shot-bar">
    {compact ? (
      <span class="shot-label">
        {tool.name} / {tool.category.toLowerCase()}
      </span>
    ) : (
      <div class="views" role="group" aria-label="Product screenshots">
        {captures.map((capture, i) => (
          <button
            type="button"
            data-view={capture.id}
            aria-pressed={i === initial}
          >
            {capture.label}
          </button>
        ))}
      </div>
    )}
    <div class="themes" role="group" aria-label="Screenshot appearance">
      <button type="button" data-theme="light" aria-pressed="false">
        Light
      </button>
      <button type="button" data-theme="dark" aria-pressed="true">
        Dark
      </button>
    </div>
  </div>
  <div
    class="shot-scroll"
    tabindex="0"
    role="region"
    aria-label={`${tool.name} screenshots; scroll horizontally on small screens to explore both panes`}
  >
    {captures.map((capture, i) => (
      <div data-capture={capture.id} hidden={i !== initial}>
        {(["dark", "light"] as const).map((theme) => (
          <div data-appearance={theme} hidden={theme === "light"}>
            <Image
              src={capture[theme]}
              alt={`${capture.alt} ${theme === "light" ? "Light" : "Dark"} theme.`}
              widths={[1100, 1650, 2200]}
              sizes="(max-width: 700px) 740px, 1100px"
              format="webp"
              loading={
                compact || i !== initial || theme === "light" ? "lazy" : "eager"
              }
              fetchpriority={
                !compact && i === initial && theme === "dark" ? "high" : "auto"
              }
            />
          </div>
        ))}
      </div>
    ))}
  </div>
  <figcaption>
    <span>{tool.screenshotCaption}</span>
    <span class="mobile-hint">
      Scroll to explore <span aria-hidden="true">↔</span>
    </span>
  </figcaption>
</figure>
<script>
  for (const shot of document.querySelectorAll<HTMLElement>(
    "[data-product-shot]",
  )) {
    const themes = shot.querySelectorAll<HTMLButtonElement>("[data-theme]");
    const views = shot.querySelectorAll<HTMLButtonElement>("[data-view]");
    themes.forEach((button) =>
      button.addEventListener("click", () => {
        themes.forEach((item) =>
          item.setAttribute("aria-pressed", String(item === button)),
        );
        shot
          .querySelectorAll<HTMLElement>("[data-appearance]")
          .forEach((image) => {
            image.hidden = image.dataset.appearance !== button.dataset.theme;
          });
      }),
    );
    views.forEach((button) =>
      button.addEventListener("click", () => {
        views.forEach((item) =>
          item.setAttribute("aria-pressed", String(item === button)),
        );
        shot
          .querySelectorAll<HTMLElement>("[data-capture]")
          .forEach((image) => {
            image.hidden = image.dataset.capture !== button.dataset.view;
          });
      }),
    );
  }
</script>
<style>
  .product-shot {
    margin: 0;
    width: 100%;
    min-width: 0;
    border: 1px solid var(--border-strong);
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg-card);
    box-shadow: 0 24px 100px #0005;
  }
  .shot-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    padding: 12px 20px;
    border-bottom: 1px solid var(--border);
    font: 11px var(--mono);
    color: var(--muted);
  }
  .themes,
  .views {
    display: flex;
    gap: 4px;
    padding: 3px;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
  }
  .shot-bar button {
    border: 0;
    border-radius: 5px;
    padding: 7px 12px;
    background: transparent;
    color: var(--muted);
    font: inherit;
    cursor: pointer;
  }
  .shot-bar button[aria-pressed="true"] {
    background: var(--fg);
    color: var(--bg);
  }
  /* The captures keep the app window's transparent rounded corners, so the
     window sits on the card with a margin instead of filling it edge to edge. */
  .shot-scroll {
    overflow-x: auto;
    padding: 20px;
  }
  .shot-scroll:focus-visible {
    outline-offset: -3px;
  }
  .shot-scroll img {
    width: 100%;
    height: auto;
    display: block;
  }
  figcaption {
    padding: 13px 20px;
    font-size: 12px;
    color: var(--muted);
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    gap: 10px;
  }
  .mobile-hint {
    display: none;
  }
  @media (max-width: 700px) {
    .shot-scroll {
      padding: 12px;
    }
    .shot-scroll img {
      width: 740px;
      max-width: none;
    }
    .shot-bar {
      padding: 10px;
      gap: 6px;
      font-size: 10px;
    }
    .shot-bar button {
      padding: 7px 8px;
    }
    .shot-label {
      max-width: 130px;
    }
    figcaption {
      padding: 12px 14px;
      display: grid;
    }
    .mobile-hint {
      display: inline;
      color: var(--accent);
    }
  }
</style>
