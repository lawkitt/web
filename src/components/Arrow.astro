---
interface Props {
  diagonal?: boolean;
}
const { diagonal = false } = Astro.props;
---

<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
  {diagonal ? (
    <path d="M7 17 17 7M7 7h10v10" />
  ) : (
    <path d="M4 12h16m-6-6 6 6-6 6" />
  )}
</svg>
<style>
  svg {
    flex-shrink: 0;
  }
  path {
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
